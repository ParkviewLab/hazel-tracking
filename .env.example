# hazel-tracking: settings for docker-compose.yml. Copy to .env beside it and edit;
# in Portainer, enter the same names as the stack's environment variables.

# A classic GitHub token with read:packages alone (docs/decisions.md, D10).
GITHUB_TOKEN_HAZEL_TRACKING=CHANGE-ME

# Optional, with these defaults.
# HAZEL_TRACKING_WAIT_SECONDS=15
# TZ=UTC
